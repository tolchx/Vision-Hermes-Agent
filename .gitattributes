# Force LF line endings for shell scripts
*.sh text eol=lf
*.bat text eol=crlf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Source code
*.swift text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.py text eol=lf
*.js text eol=lf

# Config
*.yml text eol=lf
*.yaml text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.plist text eol=lf
